 static int synaptics_tcm_power_on(struct synaptics_tcm_core *ts)
 {
@@ -173,6 +174,57 @@ static int synaptics_tcm_continue_read(struct synaptics_tcm_core *ts, size_t len
 
 }
 
+static int synaptics_tcm_read_cmd_resp(struct synaptics_tcm_core *ts,
+				       unsigned char cmd,
+				       struct synaptics_tcm_v1_message_header *header)
+{
+	int attempt, ret;
+
+	ret = synaptics_tcm_write_cmd(ts, cmd, NULL, 0);
+	if (ret) {
+		dev_warn(ts->dev, "cmd 0x%02x write failed: %d\n", cmd, ret);
+		return ret;
+	}
+
+	msleep(40);
+
+	for (attempt = 0; attempt < 8; attempt++) {
+		ret = synaptics_tcm_read_header(ts, (unsigned char *)header);
+		if (ret)
+			return ret;
+
+		if (header->marker == SYNAPTICS_TCM_V1_MESSAGE_MARKER &&
+		    header->code == TCM_STATUS_OK)
+			return 0;
+
+		if (header->marker == SYNAPTICS_TCM_V1_MESSAGE_MARKER &&
+		    header->code >= REPORT_IDENTIFY) {
+			unsigned int len = get_unaligned_le16(header->length);
+
+			if (len > 0 && len <= 4096) {
+				unsigned char *discard = kzalloc(len, GFP_KERNEL);
+
+				if (!discard)
+					return -ENOMEM;
+				ret = synaptics_tcm_continue_read(ts, len, discard);
+				kfree(discard);
+				if (ret)
+					return ret;
+			}
+			msleep(15);
+			continue;
+		}
+
+		dev_warn(ts->dev,
+			 "cmd 0x%02x unexpected response marker=0x%02x code=0x%02x\n",
+			 cmd, header->marker, header->code);
+		return -EIO;
+	}
+
+	dev_warn(ts->dev, "cmd 0x%02x timed out draining async reports\n", cmd);
+	return -ETIMEDOUT;
+}
