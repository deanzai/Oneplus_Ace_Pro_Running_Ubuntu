+static void qcom_battmgr_oplus_probe_pd_caps(struct qcom_battmgr *battmgr,
+					     int *max_9v_curr_ma,
+					     int *max_5v_curr_ma)
+{
+	int ret, i;
+
+	*max_9v_curr_ma = 0;
+	*max_5v_curr_ma = 0;
+
+	mutex_lock(&battmgr->lock);
+	qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET,
+				      USB_ADAP_SUBTYPE, 0);
+	qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET,
+				      USB_GET_PPS_TYPE, 0);
+	qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+				      BATT_CHG_CTRL_LIM_MAX, 0);
+	mutex_unlock(&battmgr->lock);
+
+	ret = qcom_battmgr_read_buffer_opcode(battmgr, PPS_OPCODE_READ_BUFFER);
+	if (!ret && battmgr->pps_read_buf_valid) {
+		for (i = 0; i < PPS_PDO_MAX; i++) {
+			u32 pdo = battmgr->pps_read_buf[i + 2];
+			u32 type = (pdo >> 30) & 0x3;
+
+			if (!pdo)
+				continue;
+
+			if (type == 0) {
+				int vol_mv = ((pdo >> 10) & 0x3ff) * 50;
+				int curr_ma = (pdo & 0x3ff) * 10;
+
+				dev_info(battmgr->dev,
+					 "oplus pd pdo[%d]: FIXED %dmV %dmA (raw=0x%08x)\n",
+					 i, vol_mv, curr_ma, pdo);
+				if (vol_mv >= 8500 && vol_mv <= 9500 &&
+				    curr_ma > *max_9v_curr_ma)
+					*max_9v_curr_ma = curr_ma;
+				if (vol_mv >= 4500 && vol_mv <= 5500 &&
+				    curr_ma > *max_5v_curr_ma)
+					*max_5v_curr_ma = curr_ma;
+			} else if (type == 3) {
+				int min_mv = ((pdo >> 8) & 0xff) * 100;
+				int max_mv = ((pdo >> 17) & 0xff) * 100;
+				int curr_ma = (pdo & 0x7f) * 50;
+
+				dev_info(battmgr->dev,
+					 "oplus pd pdo[%d]: PPS %d-%dmV %dmA (raw=0x%08x)\n",
+					 i, min_mv, max_mv, curr_ma, pdo);
+				if (max_mv >= 9000 && curr_ma > *max_9v_curr_ma)
+					*max_9v_curr_ma = curr_ma;
+			}
+		}
+	}
+
+	dev_info(battmgr->dev,
+		 "oplus pd caps: subtype=%u pps_type=%u fcc_lim_max=%u max_5v=%dmA max_9v=%dmA\n",
+		 battmgr->usb.adap_subtype, battmgr->usb.pps_type,
+		 battmgr->batt_chg_ctrl_lim_max, *max_5v_curr_ma, *max_9v_curr_ma);
+}
