+static void qcom_battmgr_oplus_set_icl_aicl(struct qcom_battmgr *battmgr,
+					    int target_icl_ma,
+					    int aicl_point_mv)
+{
+	static const int usb_icl_ma[] = {
+		100, 500, 900, 1200, 1350, 1500, 1750, 2000, 3000,
+	};
+	int i, last_good_idx = 1;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(usb_icl_ma); i++) {
+		if (i > 0 && usb_icl_ma[i] > target_icl_ma)
+			break;
+
+		mutex_lock(&battmgr->lock);
+		ret = qcom_battmgr_request_property(battmgr,
+						    BATTMGR_USB_PROPERTY_SET,
+						    USB_INPUT_CURR_LIMIT,
+						    usb_icl_ma[i] * 1000);
+		mutex_unlock(&battmgr->lock);
+		if (ret) {
+			dev_warn(battmgr->dev,
+				 "oplus aicl: set ICL %dmA failed: %d\n",
+				 usb_icl_ma[i], ret);
+			break;
+		}
+
+		if (usb_icl_ma[i] < 500) {
+			usleep_range(25000, 26000);
+			if (target_icl_ma < 500)
+				break;
+			continue;
+		}
+
+		msleep(usb_icl_ma[i] == 1350 ? 130 : 60);
+
+		mutex_lock(&battmgr->lock);
+		qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET,
+					      USB_VBUS_COLLAPSE_STATUS, 0);
+		qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET,
+					      USB_VOLT_NOW, 0);
+		mutex_unlock(&battmgr->lock);
+
+		if (battmgr->usb.vbus_collapse ||
+		    (battmgr->usb.voltage_now > 0 &&
+		     battmgr->usb.voltage_now < (unsigned int)aicl_point_mv * 1000)) {
+			int back_ma = usb_icl_ma[last_good_idx];
+
+			dev_info(battmgr->dev,
+				 "oplus aicl: VBUS sag at %dmA (vbus=%uuV collapse=%u < %dmV), backing down to %dmA\n",
+				 usb_icl_ma[i], battmgr->usb.voltage_now,
+				 battmgr->usb.vbus_collapse, aicl_point_mv, back_ma);
+			mutex_lock(&battmgr->lock);
+			qcom_battmgr_request_property(battmgr,
+						      BATTMGR_USB_PROPERTY_SET,
+						      USB_INPUT_CURR_LIMIT,
+						      back_ma * 1000);
+			mutex_unlock(&battmgr->lock);
+			return;
+		}
+		last_good_idx = i;
+	}
+
+	dev_info(battmgr->dev, "oplus aicl: settled ICL at %dmA (vbus=%uuV)\n",
+		 usb_icl_ma[last_good_idx], battmgr->usb.voltage_now);
+}
