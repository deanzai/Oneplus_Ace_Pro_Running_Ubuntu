+
+static bool sc8280xp_is_legacy_of_route(const struct snd_soc_dapm_route *r)
+{
+	if (!r->sink || !r->source)
+		return false;
+
+	if (!strcmp(r->sink, "TX SWR_INPUT") ||
+	    !strcmp(r->sink, "VA SWR_INPUT") ||
+	    !strcmp(r->source, "WCD_TX_OUTPUT") ||
+	    !strncmp(r->sink, "VA AMIC", 7))
+		return true;
+
+	return false;
+}
+
+/*
+ * Older sm8475 device trees carry downstream widget names (VA AMIC*,
+ * TX/VA SWR_INPUT, WCD_TX_OUTPUT) that do not exist in mainline codecs;
+ * drop them and install the matching mainline WCD->TX SWR ADC routes.
+ */
+static void sc8280xp_sanitize_of_routes(struct snd_soc_card *card)
+{
+	struct snd_soc_dapm_route *filtered;
+	int i, kept = 0;
+	bool need_wcd_tx = false, has_legacy = false;
+
+	if (!card->of_dapm_routes || !card->num_of_dapm_routes)
+		return;
+
+	for (i = 0; i < card->num_of_dapm_routes; i++) {
+		if (sc8280xp_is_legacy_of_route(&card->of_dapm_routes[i])) {
+			has_legacy = true;
+			break;
+		}
+	}
+	if (!has_legacy)
+		return;
+
+	filtered = devm_kcalloc(card->dev, card->num_of_dapm_routes,
+				sizeof(*filtered), GFP_KERNEL);
+	if (!filtered)
+		return;
+
+	for (i = 0; i < card->num_of_dapm_routes; i++) {
+		const struct snd_soc_dapm_route *r = &card->of_dapm_routes[i];
+
+		if (sc8280xp_is_legacy_of_route(r)) {
+			if (r->source && !strcmp(r->source, "WCD_TX_OUTPUT"))
+				need_wcd_tx = true;
+			continue;
+		}
+		filtered[kept++] = *r;
+	}
+
+	card->of_dapm_routes = filtered;
+	card->num_of_dapm_routes = kept;
+	if (need_wcd_tx && !card->dapm_routes) {
+		card->dapm_routes = sm8475_wcd_tx_routes;
+		card->num_dapm_routes = ARRAY_SIZE(sm8475_wcd_tx_routes);
+	}
+}
