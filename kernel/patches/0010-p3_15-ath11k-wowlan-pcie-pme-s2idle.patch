+static irqreturn_t ath11k_pcic_wake_interrupt_handler(int irq, void *arg)
+{
+	struct ath11k_base *ab = arg;
+
+	ath11k_info(ab, "wake msi irq %d triggered system wakeup\n", irq);
+	pm_wakeup_dev_event(ab->dev, 0, true);
+
+	return IRQ_HANDLED;
+}
+
+void ath11k_pcic_wow_wake_irq_enable(struct ath11k_base *ab)
+{
+	int pipe;
+
+	if (ab->wow.wake_irq_enabled)
+		return;
+
+	WRITE_ONCE(ab->wow.wake_irq_enabled, true);
+
+	if (ab->wow.d0_wow &&
+	    test_bit(ATH11K_FLAG_MULTI_MSI_VECTORS, &ab->dev_flags)) {
+		for (pipe = 1; pipe <= 2; pipe++) {
+			int irq = ab->irq_num[ATH11K_PCI_IRQ_CE0_OFFSET + pipe];
+
+			if (irq <= 0)
+				continue;
+			clear_bit(pipe, &ab->wow.ce_wake_masked);
+			set_bit(pipe, &ab->wow.ce_wake_armed);
+			smp_mb__after_atomic();
+			if (enable_irq_wake(irq) == 0)
+				set_bit(pipe, &ab->wow.ce_wake_irq_wake_mask);
+			enable_irq(irq);
+		}
+	}
+
+	if (ab->wow.pewake_irq > 0) {
+		ab->wow.pewake_irq_wake_enabled =
+			(enable_irq_wake(ab->wow.pewake_irq) == 0);
+	}
+
+	if (ab->wow.wake_irq > 0) {
+		enable_irq(ab->wow.wake_irq);
+		ab->wow.wake_irq_wake_enabled =
+			(enable_irq_wake(ab->wow.wake_irq) == 0);
+	}
+}
+EXPORT_SYMBOL(ath11k_pcic_wow_wake_irq_enable);
+
+void ath11k_pcic_wow_wake_irq_disable(struct ath11k_base *ab)
+{
+	int pipe;
+
+	if (!ab->wow.wake_irq_enabled)
+		return;
+
+	WRITE_ONCE(ab->wow.wake_irq_enabled, false);
+
+	if (ab->wow.pewake_irq > 0 && ab->wow.pewake_irq_wake_enabled) {
+		disable_irq_wake(ab->wow.pewake_irq);
+		ab->wow.pewake_irq_wake_enabled = false;
+	}
+
+	if (ab->wow.wake_irq > 0) {
+		if (ab->wow.wake_irq_wake_enabled) {
+			disable_irq_wake(ab->wow.wake_irq);
+			ab->wow.wake_irq_wake_enabled = false;
+		}
+		disable_irq_nosync(ab->wow.wake_irq);
+	}
+
+	if (ab->wow.d0_wow) {
+		for (pipe = 1; pipe <= 2; pipe++) {
+			int irq = ab->irq_num[ATH11K_PCI_IRQ_CE0_OFFSET + pipe];
+
+			if (irq <= 0)
+				continue;
+			if (test_and_clear_bit(pipe, &ab->wow.ce_wake_armed)) {
+				smp_mb__after_atomic();
+				if (!test_and_set_bit(pipe, &ab->wow.ce_wake_masked))
+					disable_irq_nosync(irq);
+				synchronize_irq(irq);
+				clear_bit(pipe, &ab->wow.ce_wake_masked);
+			}
+			if (test_and_clear_bit(pipe, &ab->wow.ce_wake_irq_wake_mask))
+				disable_irq_wake(irq);
+		}
+	}
+}
+EXPORT_SYMBOL(ath11k_pcic_wow_wake_irq_disable);
