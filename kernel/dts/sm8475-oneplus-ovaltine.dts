		map1 {
			trip = <&cpu7_bottom_alert1>;
			cooling-device = <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
		};
	};
};

/*
 * Mainline CONFIG_CRYPTO_DEV_QCE is marked BROKEN and unbound on SM8475;
 * keeping crypto@1dfa000 enabled prevents qnoc-sm8450 icc_sync_state(),
 * pinning LLCC/EBI/GEMNOC boot proxy bandwidth at INT_MAX (2147483647).
 */
&crypto {
	status = "disabled";
};
