[Unit]
Description=Mark current Qualcomm A/B boot slot as successful
After=local-fs.target systemd-udevd.service
Requires=systemd-udevd.service
ConditionPathExists=/usr/local/bin/qbootctl
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=oneshot
ExecStartPre=/bin/sh -c "for i in $(seq 1 20); do [ -e /dev/disk/by-partlabel/boot_a ] && exit 0; /bin/udevadm settle --timeout=2; sleep 1; done; exit 0"
ExecStart=/usr/local/bin/qbootctl -m
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
