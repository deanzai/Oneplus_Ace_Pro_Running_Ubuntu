[Unit]
Description=Configure Ace Pro USB ConfigFS Gadget (CDC-NCM + ACM)
DefaultDependencies=no
After=systemd-modules-load.service sys-kernel-config.mount
Wants=sys-kernel-config.mount
Before=network.target ssh.service getty.target serial-getty@ttyGS0.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/acepro-usb-gadget.sh

[Install]
WantedBy=multi-user.target
